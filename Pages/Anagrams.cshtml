@page
@model wordgame.Pages.AnagramsModel
@inject wordgame.Contracts.IWordReader wordReader
@{
    var theWord = wordReader.GetWord(new Random().Next(8, 10));
    var questions = wordReader.GetAnagramWords(theWord);
    var questionWords = questions.Keys.ToArray();
    Random.Shared.Shuffle(questionWords);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101827">
    <title>Anagrams | Word Game</title>
    <style>
        :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #101827; color: #edf2f7; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; background: radial-gradient(ellipse at top, #23334c 0%, #101827 58%); }
        button { font: inherit; }
        .page { width: min(760px, calc(100% - 32px)); margin: 0 auto; padding: 42px 0 64px; }
        .topline { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; color: #9eacc0; font-size: .82rem; letter-spacing: .12em; text-transform: uppercase; }
        .topline a { color: #a9c8ff; text-decoration: none; letter-spacing: 0; text-transform: none; }
        h1 { margin: 0; font-size: clamp(2rem, 6vw, 3rem); letter-spacing: -.045em; }
        .intro { color: #aab7c9; line-height: 1.6; margin: 10px 0 28px; }
        .panel { background: rgba(24, 37, 56, .92); border: 1px solid #34445c; border-radius: 20px; padding: clamp(20px, 5vw, 32px); box-shadow: 0 22px 70px rgba(0,0,0,.2); }
        .status { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
        .timer-label, .progress-label { color: #9eacc0; font-size: .82rem; text-transform: uppercase; letter-spacing: .1em; }
        .timer { display: block; color: #fff; font-size: 2rem; font-weight: 750; font-variant-numeric: tabular-nums; line-height: 1.2; }
        .timer.urgent { color: #ff9b8f; }
        .progress { text-align: right; color: #d9e4f3; font-weight: 650; }
        .source-wrap { text-align: center; padding: 22px 12px 28px; border-bottom: 1px solid #34445c; }
        .eyebrow { color: #9eacc0; font-size: .8rem; text-transform: uppercase; letter-spacing: .13em; }
        .source { margin: 9px 0 6px; font-size: clamp(2rem, 8vw, 3.4rem); font-weight: 800; letter-spacing: .14em; overflow-wrap: anywhere; }
        .hint { color: #9eacc0; font-size: .9rem; }
        .choices-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 24px 0 14px; }
        .choices-heading h2 { font-size: 1rem; margin: 0; }
        .choices-heading span { color: #9eacc0; font-size: .82rem; }
        .choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
        .choice { position: relative; }
        .choice input { position: absolute; opacity: 0; pointer-events: none; }
        .choice label { display: flex; align-items: center; justify-content: center; min-height: 54px; padding: 12px; border: 1px solid #465873; border-radius: 12px; background: #202f45; color: #e5edf8; font-weight: 650; cursor: pointer; transition: border-color .15s, background .15s, transform .15s; overflow-wrap: anywhere; text-align: center; }
        .choice label:hover { border-color: #91baff; transform: translateY(-1px); }
        .choice input:checked + label { background: #29466d; border-color: #8bb8ff; color: #fff; box-shadow: inset 0 0 0 1px #8bb8ff; }
        .choice input:focus-visible + label { outline: 3px solid #c2dcff; outline-offset: 3px; }
        .choice input:disabled + label { cursor: default; opacity: .82; }
        .actions { display: flex; gap: 12px; margin-top: 24px; }
        .action { min-height: 50px; border: 0; border-radius: 12px; padding: 0 20px; font-weight: 750; cursor: pointer; }
        .action.primary { flex: 1; background: #a9c8ff; color: #122139; }
        .action.primary:hover:not(:disabled) { background: #c4d9ff; }
        .action.secondary { background: #34445c; color: #edf2f7; }
        .action:disabled { opacity: .45; cursor: not-allowed; }
        .message { color: #9eacc0; font-size: .9rem; text-align: center; min-height: 1.4em; margin: 14px 0 0; }
        [hidden] { display: none !important; }
        .results { text-align: center; }
        .result-score { font-size: clamp(3rem, 12vw, 5rem); font-weight: 850; letter-spacing: -.06em; margin: 8px 0 0; }
        .result-caption { color: #aab7c9; margin: 0 0 24px; }
        .result-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 24px 0; }
        .stat { padding: 16px 8px; border: 1px solid #40516a; border-radius: 12px; background: #202f45; }
        .stat strong { display: block; font-size: 1.6rem; }
        .stat span { color: #aab7c9; font-size: .78rem; }
        .review { text-align: left; margin-top: 24px; }
        .review h2 { font-size: 1rem; }
        .review-list { display: grid; gap: 8px; }
        .review-item { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 9px; background: #202f45; font-size: .9rem; }
        .review-item.good { color: #a8e5c0; }
        .review-item.missed { color: #ffd18b; }
        .review-item.wrong { color: #ffaaa0; }
        @media (max-width: 480px) { .page { padding-top: 26px; } .choices { grid-template-columns: 1fr 1fr; gap: 8px; } .choice label { min-height: 50px; padding: 10px 6px; font-size: .9rem; } .actions { flex-direction: column; } .action { width: 100%; } }
    </style>
</head>
<body>
    <main class="page">
        <div class="topline"><span>Word Game</span><a href="/">Back to Word Hunt</a></div>
        <h1>Anagrams</h1>
        <p class="intro">Find the words hidden inside the source word. Select every valid anagram you can spot before the timer runs out.</p>
        <section class="panel" aria-labelledby="source-word">
            <div class="status">
                <div><span class="timer-label">Time left</span><strong class="timer" id="timer">60</strong></div>
                <div class="progress"><span class="progress-label">Selected</span><div><span id="selected-count">0</span> / @questionWords.Length</div></div>
            </div>
            <div class="source-wrap">
                <div class="eyebrow">Build from these letters</div>
                <div class="source" id="source-word">@theWord</div>
                <div class="hint">Use each letter no more times than it appears.</div>
            </div>
            <div class="choices-heading"><h2>Which words are valid?</h2><span>Choose all that apply</span></div>
            <div class="choices" id="choices">
                @foreach (var key in questionWords)
                {
                    <div class="choice">
                        <input class="answer" type="checkbox" id="choice-@key" data-word="@key" data-correct="@questions[key].ToString().ToLowerInvariant()" disabled>
                        <label for="choice-@key">@key</label>
                    </div>
                }
            </div>
            <div class="actions" id="game-actions">
                <button class="action primary" id="start-button" type="button">Start game</button>
                <button class="action secondary" id="submit-button" type="button" disabled>Finish round</button>
            </div>
            <p class="message" id="message" aria-live="polite">You have 60 seconds. The clock starts when you are ready.</p>
            <section class="results" id="results" hidden aria-live="polite">
                <div class="eyebrow" id="result-heading">Round complete</div>
                <div class="result-score" id="result-score">0</div>
                <p class="result-caption">points</p>
                <div class="result-stats">
                    <div class="stat"><strong id="correct-count">0</strong><span>Correct picks</span></div>
                    <div class="stat"><strong id="missed-count">0</strong><span>Missed words</span></div>
                    <div class="stat"><strong id="wrong-count">0</strong><span>Wrong picks</span></div>
                </div>
                <div class="review"><h2>Answer review</h2><div class="review-list" id="review-list"></div></div>
                <div class="actions"><button class="action primary" id="play-again" type="button">Play again</button></div>
            </section>
        </section>
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const duration = 60;
            const timer = document.getElementById('timer');
            const startButton = document.getElementById('start-button');
            const submitButton = document.getElementById('submit-button');
            const playAgainButton = document.getElementById('play-again');
            const message = document.getElementById('message');
            const results = document.getElementById('results');
            const answers = [...document.querySelectorAll('.answer')];
            const selectedCount = document.getElementById('selected-count');
            let secondsLeft = duration;
            let timerInterval = null;
            let started = false;
            let finished = false;

            function updateSelectedCount() {
                selectedCount.textContent = answers.filter(answer => answer.checked).length;
            }

            function finishRound(expired) {
                if (!started || finished) return;
                finished = true;
                clearInterval(timerInterval);
                answers.forEach(answer => answer.disabled = true);
                startButton.hidden = true;
                submitButton.hidden = true;
                message.hidden = true;
                results.hidden = false;

                let correct = 0, missed = 0, wrong = 0, score = 0;
                const reviewList = document.getElementById('review-list');
                reviewList.replaceChildren();

                answers.forEach(answer => {
                    const isCorrect = answer.dataset.correct === 'true';
                    const isSelected = answer.checked;
                    let status, className;
                    if (isCorrect && isSelected) { correct++; score++; status = 'Correct'; className = 'good'; }
                    else if (isCorrect) { missed++; status = 'Missed'; className = 'missed'; }
                    else if (isSelected) { wrong++; score--; status = 'Not an anagram'; className = 'wrong'; }
                    else return;

                    const row = document.createElement('div');
                    row.className = 'review-item ' + className;
                    const word = document.createElement('strong');
                    word.textContent = answer.dataset.word;
                    const outcome = document.createElement('span');
                    outcome.textContent = status;
                    row.append(word, outcome);
                    reviewList.append(row);
                });

                document.getElementById('result-score').textContent = score;
                document.getElementById('correct-count').textContent = correct;
                document.getElementById('missed-count').textContent = missed;
                document.getElementById('wrong-count').textContent = wrong;
                document.getElementById('result-heading').textContent = expired ? "Time's up" : 'Round complete';
            }

            function startGame() {
                if (started || finished) return;
                started = true;
                startButton.disabled = true;
                startButton.textContent = 'Game in progress';
                submitButton.disabled = false;
                answers.forEach(answer => answer.disabled = false);
                message.textContent = 'Select the valid anagrams. You can finish early at any time.';
                timerInterval = setInterval(() => {
                    secondsLeft--;
                    timer.textContent = secondsLeft;
                    if (secondsLeft <= 10) timer.classList.add('urgent');
                    if (secondsLeft <= 0) finishRound(true);
                }, 1000);
            }

            answers.forEach(answer => answer.addEventListener('change', updateSelectedCount));
            startButton.addEventListener('click', startGame);
            submitButton.addEventListener('click', () => finishRound(false));
            playAgainButton.addEventListener('click', () => window.location.reload());
        });
    </script>
</body>
</html>
