@page
@model wordgame.Pages.AnagramsModel
@inject wordgame.Contracts.IWordReader wordReader
@{
    var theWord = wordReader.GetWord(new Random().Next(8, 10));
    var questions = wordReader.GetAnagramWords(theWord);
    var questionWords = questions.Keys.ToArray();
    Random.Shared.Shuffle(questionWords);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f2e7c7">
    <title>Anagrams | Word Game</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Nunito:wght@500;700;800;900&display=swap" rel="stylesheet">
    <style>

        :root {
            --ink: #17261f; --paper: #fffaf0; --cream: #f2e7c7;
            --orange: #f26c3d; --mint: #d6efc7; --line: #17261f;
            color-scheme: light; font-family: Nunito, system-ui, sans-serif;
            background: var(--cream); color: var(--ink);
        }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; background: var(--cream); color: var(--ink); }
        button { font: inherit; }
        .page { width: min(100%, 940px); min-height: 100vh; margin: 0 auto; padding: 0 28px 56px; background: var(--paper); border-inline: 2px solid var(--line); }
        .topline { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 19px 0 16px; border-bottom: 2px solid var(--line); color: var(--ink); font-size: .78rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
        .topline a { color: var(--ink); font-size: .8rem; letter-spacing: 0; text-decoration-thickness: 2px; text-underline-offset: 4px; text-transform: none; }
        h1 { margin: 30px 0 0; font-family: "DM Serif Display", Georgia, serif; font-size: clamp(2.8rem, 7vw, 4.8rem); font-weight: 400; letter-spacing: -.055em; line-height: .95; }
        .intro { max-width: 560px; margin: 13px 0 27px; color: #536158; font-family: "DM Serif Display", Georgia, serif; font-size: 1.2rem; line-height: 1.35; }
        .panel { position: relative; overflow: hidden; background: #fffdf7; border: 2px solid var(--line); box-shadow: 8px 8px 0 var(--line); padding: clamp(18px, 4vw, 34px); }
        .panel::before { position: absolute; top: 0; left: 0; width: 100%; height: 8px; background: var(--orange); content: ""; }
        .status { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: 6px 0 25px; }
        .timer-label, .progress-label { display: block; color: #68756b; font-size: .7rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
        .timer { display: block; margin-top: 3px; color: var(--ink); font-size: 2.1rem; font-weight: 900; font-variant-numeric: tabular-nums; line-height: 1; }
        .timer.urgent { color: #c53c2c; }
        .progress { min-width: 108px; padding: 9px 13px; border: 1.5px solid var(--line); background: var(--mint); text-align: right; color: var(--ink); font-weight: 900; }
        .progress-label { margin-bottom: 3px; }
        .source-wrap { position: relative; padding: 28px 16px 30px; border: 1.5px dashed #a9aa91; background: var(--cream); text-align: center; }
        .eyebrow { color: #697367; font-size: .7rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
        .source { margin: 13px 0 8px; color: var(--ink); font-family: "DM Serif Display", Georgia, serif; font-size: clamp(2.3rem, 9vw, 4.3rem); font-weight: 400; letter-spacing: .12em; line-height: 1; overflow-wrap: anywhere; }
        .hint { color: #68756b; font-size: .84rem; font-weight: 700; }
        .choices-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 27px 0 13px; }
        .choices-heading h2 { margin: 0; font-size: 1rem; font-weight: 900; letter-spacing: -.02em; }
        .choices-heading span { color: #68756b; font-size: .78rem; font-weight: 800; }
        .choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; transition: filter .2s, opacity .2s; }
        .choices.is-locked { filter: blur(7px); opacity: .55; pointer-events: none; user-select: none; }
        .choice { position: relative; min-width: 0; }
        .choice input { position: absolute; width: 1px; height: 1px; opacity: 0; }
        .choice label { display: flex; align-items: center; justify-content: center; min-height: 56px; padding: 11px 10px; border: 1.5px solid var(--line); background: #fffaf0; color: var(--ink); font-size: .96rem; font-weight: 900; cursor: pointer; transition: background .14s, transform .14s, box-shadow .14s; overflow-wrap: anywhere; text-align: center; }
        .choice label:hover { background: var(--cream); transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--line); }
        .choice input:checked + label { background: var(--mint); box-shadow: inset 0 0 0 2px var(--ink); }
        .choice input:checked + label::before { content: "✓"; margin-right: 7px; color: #287449; }
        .choice input:focus-visible + label { outline: 3px solid var(--orange); outline-offset: 3px; }
        .choice input:disabled + label { cursor: default; opacity: .76; }
        .actions { display: flex; gap: 10px; margin-top: 25px; }
        .action { min-height: 50px; border: 2px solid var(--line); border-radius: 0; padding: 0 20px; font-weight: 900; cursor: pointer; transition: transform .14s, box-shadow .14s, background .14s; }
        .action.primary { flex: 1; background: var(--orange); color: #201d16; }
        .action.primary:hover:not(:disabled) { background: #ff855b; transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--line); }
        .action.secondary { background: var(--ink); color: var(--paper); }
        .action:disabled { opacity: .48; cursor: not-allowed; }
        .message { min-height: 1.4em; margin: 14px 0 0; color: #68756b; font-size: .85rem; font-weight: 800; text-align: center; }
        [hidden] { display: none !important; }
        .results { padding-top: 10px; text-align: center; }
        .result-score { margin: 8px 0 0; font-family: "DM Serif Display", Georgia, serif; font-size: clamp(4rem, 14vw, 6.5rem); font-weight: 400; letter-spacing: -.06em; line-height: 1; }
        .result-caption { margin: 0 0 24px; color: #68756b; font-size: .82rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
        .result-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; margin: 24px 0; }
        .stat { padding: 15px 8px; border: 1.5px solid var(--line); background: var(--cream); }
        .stat strong { display: block; font-size: 1.65rem; font-weight: 900; }
        .stat span { color: #68756b; font-size: .72rem; font-weight: 900; text-transform: uppercase; }
        .review { margin-top: 25px; text-align: left; }
        .review h2 { margin-bottom: 12px; font-family: "DM Serif Display", Georgia, serif; font-size: 1.55rem; font-weight: 400; }
        .review-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
        .review-item { display: flex; justify-content: space-between; gap: 10px; padding: 10px 12px; border: 1px solid #d8d4c4; background: #fffaf0; font-size: .85rem; }
        .review-item.good { border-left: 4px solid #39875b; }
        .review-item.missed { border-left: 4px solid #d89b37; }
        .review-item.wrong { border-left: 4px solid #c94b3c; }
        @@media (max-width: 620px) {
            .page { padding: 0 15px 36px; }
            .topline { padding-top: 15px; }
            h1 { margin-top: 25px; }
            .intro { margin-bottom: 22px; font-size: 1.08rem; }
            .panel { box-shadow: 5px 5px 0 var(--line); padding: 18px 14px; }
            .choices { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
            .choice label { min-height: 51px; padding: 9px 5px; font-size: .88rem; }
            .actions { flex-direction: column; }
            .action { width: 100%; }
            .review-list { grid-template-columns: 1fr; }
        }
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
        }
    </style>
</head>
<body>
    <main class="page">
        <div class="topline"><span>Word Game</span><a href="/">Back to Word Hunt</a></div>
        <h1>Anagrams</h1>
        <p class="intro">Find the words hidden inside the source word. Select every valid anagram you can spot before the timer runs out.</p>
        <section class="panel" aria-labelledby="source-word">
            <div class="status">
                <div><span class="timer-label">Time left</span><strong class="timer" id="timer">60</strong></div>
                <div class="progress"><span class="progress-label">Selected</span><div><span id="selected-count">0</span> / @questionWords.Length</div></div>
            </div>
            <div class="source-wrap">
                <div class="eyebrow">Build from these letters</div>
                <div class="source" id="source-word">@theWord</div>
                <div class="hint">Use each letter no more times than it appears.</div>
            </div>
            <div class="choices-heading"><h2>Which words are valid?</h2><span>Choose all that apply</span></div>
            <div class="choices is-locked" id="choices">
                @foreach (var key in questionWords)
                {
                    <div class="choice">
                        <input class="answer" type="checkbox" id="choice-@key" data-word="@key" data-correct="@questions[key].ToString().ToLowerInvariant()" disabled>
                        <label for="choice-@key">@key</label>
                    </div>
                }
            </div>
            <div class="actions" id="game-actions">
                <button class="action primary" id="start-button" type="button">Start game</button>
                <button class="action secondary" id="submit-button" type="button" disabled>Finish round</button>
            </div>
            <p class="message" id="message" aria-live="polite">You have 60 seconds. The clock starts when you are ready.</p>
            <section class="results" id="results" hidden aria-live="polite">
                <div class="eyebrow" id="result-heading">Round complete</div>
                <div class="result-score" id="result-score">0</div>
                <p class="result-caption">points</p>
                <div class="result-stats">
                    <div class="stat"><strong id="correct-count">0</strong><span>Correct picks</span></div>
                    <div class="stat"><strong id="missed-count">0</strong><span>Missed words</span></div>
                    <div class="stat"><strong id="wrong-count">0</strong><span>Wrong picks</span></div>
                </div>
                <div class="review"><h2>Answer review</h2><div class="review-list" id="review-list"></div></div>
                <div class="actions"><button class="action primary" id="play-again" type="button">Play again</button></div>
            </section>
        </section>
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const duration = 60;
            const timer = document.getElementById('timer');
            const startButton = document.getElementById('start-button');
            const submitButton = document.getElementById('submit-button');
            const playAgainButton = document.getElementById('play-again');
            const message = document.getElementById('message');
            const results = document.getElementById('results');
            const answers = [...document.querySelectorAll('.answer')];
            const choices = document.getElementById('choices');
            const selectedCount = document.getElementById('selected-count');
            let secondsLeft = duration;
            let timerInterval = null;
            let started = false;
            let finished = false;

            function updateSelectedCount() {
                selectedCount.textContent = answers.filter(answer => answer.checked).length;
            }

            function finishRound(expired) {
                if (!started || finished) return;
                finished = true;
                clearInterval(timerInterval);
                answers.forEach(answer => answer.disabled = true);
                startButton.hidden = true;
                submitButton.hidden = true;
                message.hidden = true;
                results.hidden = false;

                let correct = 0, missed = 0, wrong = 0, score = 0;
                const reviewList = document.getElementById('review-list');
                reviewList.replaceChildren();

                answers.forEach(answer => {
                    const isCorrect = answer.dataset.correct === 'true';
                    const isSelected = answer.checked;
                    let status, className;
                    if (isCorrect && isSelected) { correct++; score++; status = 'Correct'; className = 'good'; }
                    else if (isCorrect) { missed++; status = 'Missed'; className = 'missed'; }
                    else if (isSelected) { wrong++; score--; status = 'Not an anagram'; className = 'wrong'; }
                    else return;

                    const row = document.createElement('div');
                    row.className = 'review-item ' + className;
                    const word = document.createElement('strong');
                    word.textContent = answer.dataset.word;
                    const outcome = document.createElement('span');
                    outcome.textContent = status;
                    row.append(word, outcome);
                    reviewList.append(row);
                });

                document.getElementById('result-score').textContent = score;
                document.getElementById('correct-count').textContent = correct;
                document.getElementById('missed-count').textContent = missed;
                document.getElementById('wrong-count').textContent = wrong;
                document.getElementById('result-heading').textContent = expired ? "Time's up" : 'Round complete';
            }

            function startGame() {
                if (started || finished) return;
                started = true;
                startButton.disabled = true;
                startButton.textContent = 'Game in progress';
                submitButton.disabled = false;
                answers.forEach(answer => answer.disabled = false);
                choices.classList.remove('is-locked');
                message.textContent = 'Select the valid anagrams. You can finish early at any time.';
                timerInterval = setInterval(() => {
                    secondsLeft--;
                    timer.textContent = secondsLeft;
                    if (secondsLeft <= 10) timer.classList.add('urgent');
                    if (secondsLeft <= 0) finishRound(true);
                }, 1000);
            }

            answers.forEach(answer => answer.addEventListener('change', updateSelectedCount));
            startButton.addEventListener('click', startGame);
            submitButton.addEventListener('click', () => finishRound(false));
            playAgainButton.addEventListener('click', () => window.location.reload());
        });
    </script>
</body>
</html>
