@page
@model wordgame.Pages.IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Word Hunt</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { min-height:100vh; background:#07111f; color:#eaf1ff; font-family:system-ui,sans-serif; }
        .hunt { max-width:760px; margin:0 auto; padding:2rem 1rem 4rem; }
        .card { background:#101f35; border:1px solid #29476e; border-radius:1.25rem; padding:1.5rem; box-shadow:0 18px 50px #0005; }
        .word { letter-spacing:.22em; font-size:clamp(2rem,9vw,4.5rem); font-weight:800; color:#f8cb61; text-align:center; overflow-wrap:anywhere; }
        .meta { color:#aec4df; font-size:.9rem; text-align:center; }
        .stat { background:#162b47; border-radius:.75rem; padding:.75rem; text-align:center; }
        .stat strong { display:block; font-size:1.5rem; color:#fff; }
        .guess { width:100%; border:2px solid #416993; border-radius:.75rem; padding:.85rem 1rem; color:#07111f; font-size:1.1rem; }
        .btn { border:0; border-radius:.75rem; padding:.85rem 1rem; font-weight:800; cursor:pointer; }
        .primary { background:#f8cb61; color:#132239; } .secondary { background:#29476e; color:#fff; }
        .message { min-height:1.5rem; text-align:center; color:#aec4df; }
        .accepted { display:flex; flex-wrap:wrap; gap:.5rem; }
        .chip { border:1px solid #4f9a78; background:#163e34; color:#d7ffe7; padding:.4rem .65rem; border-radius:999px; }
        .hidden { display:none; } .end { border-color:#f8cb61; }
    </style>
</head>
<body>
<main class="hunt">
    <header class="text-center mb-6"><p class="uppercase tracking-widest text-sm text-blue-200">Daily Word Hunt</p><h1 class="text-3xl font-bold">Make words. Keep the streak alive.</h1></header>
    <section class="card" aria-live="polite">
        <p id="date" class="meta">Loading today’s puzzle…</p><p id="source-word" class="word">—</p><p id="solution-count" class="meta"></p>
        <div class="grid grid-cols-3 gap-3 my-6"><div class="stat"><span class="meta">TIME</span><strong id="timer">90</strong></div><div class="stat"><span class="meta">SCORE</span><strong id="score">0</strong></div><div class="stat"><span class="meta">WORDS</span><strong id="count">0</strong></div></div>
        <form id="guess-form" class="flex gap-2" autocomplete="off"><label class="sr-only" for="guess">Enter a word</label><input id="guess" class="guess" maxlength="32" inputmode="text" autocapitalize="none" placeholder="Type a word…" disabled><button id="submit" class="btn primary" type="submit" disabled>Submit</button></form>
        <p id="message" class="message mt-3"></p><div class="mt-5"><p class="meta mb-2">FOUND WORDS</p><div id="accepted" class="accepted"></div></div>
    </section>
    <section id="results" class="card end mt-4 hidden"><h2 class="text-2xl font-bold text-center">Round complete</h2><p id="summary" class="text-center mt-2"></p><div class="flex gap-2 mt-4"><button id="share" class="btn primary flex-1">Copy result</button><button id="new-round" class="btn secondary flex-1">Play again</button></div><details class="mt-5"><summary class="cursor-pointer font-bold">Show missed words</summary><div id="missed" class="accepted mt-3"></div></details></section>
</main>
<script>
(() => {
 const state={word:'',seconds:90,score:0,found:new Set(),solutions:[],ended:false,timer:null}; const $=id=>document.getElementById(id);
 const message=(text,color)=>{ $('message').textContent=text; $('message').className='message mt-3 '+(color||'text-blue-200'); };
 const stats=()=>{ $('timer').textContent=state.seconds; $('score').textContent=state.score; $('count').textContent=state.found.size; };
 const chip=word=>{ const el=document.createElement('span'); el.className='chip'; el.textContent=word; return el; };
 const end=async()=>{ if(state.ended)return; state.ended=true; clearInterval(state.timer); $('guess').disabled=true; $('submit').disabled=true; const res=await fetch('/api/solutions'); state.solutions=res.ok?await res.json():[]; const missed=state.solutions.filter(word=>!state.found.has(word)); $('summary').textContent=state.score+' points · '+state.found.size+' words found · '+missed.length+' still hidden'; $('missed').replaceChildren(...missed.map(chip)); $('results').classList.remove('hidden'); message('Time’s up — review the words you missed.','text-yellow-200'); };
 const start=async()=>{ const res=await fetch('/api/puzzle'); const puzzle=await res.json(); state.word=puzzle.word; $('source-word').textContent=puzzle.word.toUpperCase(); $('date').textContent='Puzzle for '+puzzle.date; $('solution-count').textContent=puzzle.solutionCount+' possible words · 90 seconds'; $('guess').disabled=false; $('submit').disabled=false; $('guess').focus(); state.timer=setInterval(()=>{state.seconds--;stats();if(state.seconds<=0)end();},1000); stats(); };
 $('guess-form').addEventListener('submit',async event=>{ event.preventDefault(); if(state.ended)return; const candidate=$('guess').value.trim().toLowerCase(); if(!candidate){message('Type a word to submit.','text-yellow-200');return;} if(state.found.has(candidate)){message('You already found that one.','text-yellow-200');return;} const res=await fetch('/api/check?c='+encodeURIComponent(candidate)); if(!res.ok){message('Not a valid word for this puzzle.','text-red-300');return;} const result=await res.json(); state.found.add(result.word); state.score+=result.points; $('accepted').append(chip(result.word)); $('guess').value=''; message('+'+result.points+' points','text-green-300'); stats(); });
 $('share').addEventListener('click',async()=>{const text='Daily Word Hunt\n'+state.score+' points · '+state.found.size+' words\n'+'🟨'.repeat(Math.min(state.found.size,10));await navigator.clipboard.writeText(text);$('share').textContent='Copied!';}); $('new-round').addEventListener('click',()=>location.reload()); start().catch(()=>message('Couldn’t load today’s puzzle. Refresh and try again.','text-red-300'));
})();
</script>
</body>
</html>

