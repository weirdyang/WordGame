@page
@model wordgame.Pages.IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Word Hunt</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Nunito:wght@500;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root { --ink:#17261f; --paper:#fffaf0; --cream:#f2e7c7; --orange:#f26c3d; --mint:#d6efc7; --line:#17261f; }
        * { box-sizing:border-box; } body { min-height:100vh; margin:0; background:var(--cream); color:var(--ink); font-family:Nunito,system-ui,sans-serif; }
        .paper { display:grid; grid-template-columns:78px minmax(0,1fr); width:min(100%,920px); min-height:100vh; margin:auto; background:var(--paper); border-inline:2px solid var(--line); }
        .rail { display:flex; flex-direction:column; justify-content:space-between; gap:28px; padding:18px 12px; background:var(--orange); border-right:2px solid var(--line); } .brand { font-size:15px; font-weight:900; line-height:.8; letter-spacing:-.08em; } .rail-copy { writing-mode:vertical-rl; font-size:10px; font-weight:900; letter-spacing:.12em; }
        .content { padding:18px 26px 38px; } .topline { display:flex; justify-content:space-between; align-items:center; gap:14px; padding-bottom:16px; border-bottom:2px solid var(--line); } .masthead { font-size:19px; font-weight:900; letter-spacing:-.06em; } .streak { padding:5px 9px; border:1.5px solid var(--line); border-radius:999px; background:var(--mint); font-size:12px; font-weight:900; white-space:nowrap; }
        .layout { display:grid; grid-template-columns:minmax(0,1fr) 190px; gap:25px; padding-top:24px; } .kicker { color:var(--orange); font-size:11px; font-weight:900; letter-spacing:.13em; } h1 { max-width:540px; margin:5px 0 0; font-family:"DM Serif Display",Georgia,serif; font-size:clamp(38px,6vw,58px); font-weight:400; line-height:.9; letter-spacing:-.05em; } .subtitle { margin:16px 0 0; font-family:"DM Serif Display",Georgia,serif; font-size:18px; line-height:1.2; }
        .letters { display:grid; grid-template-columns:repeat(auto-fit,minmax(48px,1fr)); gap:6px; max-width:440px; margin:23px 0 16px; } .letter { display:grid; aspect-ratio:1; place-items:center; border:1.5px solid var(--line); background:var(--cream); font-size:25px; font-weight:900; }
        .guess-form { display:flex; max-width:440px; } .guess { min-width:0; flex:1; padding:12px 13px; border:2px solid var(--line); border-right:0; border-radius:0; background:#fffef8; color:var(--ink); font:700 16px Nunito,system-ui,sans-serif; } .submit { border:2px solid var(--line); background:var(--ink); color:var(--paper); padding:10px 14px; font:800 14px Nunito,system-ui,sans-serif; cursor:pointer; } .submit:disabled,.guess:disabled { opacity:.55; cursor:not-allowed; }
        .notice { min-height:22px; margin:8px 0 0; font-size:13px; font-weight:800; } .notice.good { color:#197044; } .notice.bad { color:#b7372f; } .notice.warn { color:#9a571b; }
        .scorecard { align-self:start; padding:17px; border:2px solid var(--line); background:var(--mint); } .scorecard h2 { margin:0; font-size:11px; letter-spacing:.11em; } .score { margin:7px 0 4px; font-size:48px; font-weight:900; line-height:1; letter-spacing:-.1em; } .scorecard p { margin:0; font-size:13px; line-height:1.35; } .scorecard hr { margin:13px 0; border:0; border-top:1.5px solid var(--line); }
        .found { margin-top:28px; padding-top:15px; border-top:2px solid var(--line); } .found-title { margin:0; font-size:11px; font-weight:900; letter-spacing:.12em; } .chips { display:flex; flex-wrap:wrap; gap:7px; margin-top:10px; } .chip { border:1.5px solid var(--line); background:var(--mint); padding:6px 9px; font-size:13px; font-weight:800; }
        .results { margin-top:24px; padding:18px; border:2px solid var(--line); background:#fffdf5; } .results h2 { margin:0; font-family:"DM Serif Display",Georgia,serif; font-size:30px; font-weight:400; } .results p { margin:6px 0 0; } .results-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:15px; } .secondary { border:2px solid var(--line); background:var(--paper); color:var(--ink); padding:9px 12px; font:800 13px Nunito,system-ui,sans-serif; cursor:pointer; } details { margin-top:16px; border-top:1.5px solid var(--line); padding-top:12px; } summary { cursor:pointer; font-weight:900; } .hidden { display:none; }
        @@media (max-width:620px) { .paper { grid-template-columns:50px minmax(0,1fr); } .rail { padding:15px 8px; } .content { padding:16px 17px 30px; } .layout { grid-template-columns:1fr; } .scorecard { display:grid; grid-template-columns:1fr auto auto; align-items:center; gap:11px; } .scorecard hr { height:45px; margin:0; border-top:0; border-left:1.5px solid var(--line); } .scorecard p br { display:none; } }
    </style>
</head>
<body>
    <main class="paper">
        <aside class="rail" aria-label="Word Hunt edition"><div class="brand">WORD<br>HUNT</div><span class="rail-copy">ONE GOOD PUZZLE, EVERY DAY</span><span id="issue" class="rail-copy">DAILY ISSUE</span></aside>
        <section class="content" aria-live="polite">
            <header class="topline"><div class="masthead">The little word paper</div><div class="streak">🔥 <span id="streak">0</span> day streak</div></header>
            <div class="layout"><section><p id="date" class="kicker">TODAY’S EDITION</p><h1>Six letters. How far can you take them?</h1><p class="subtitle">Find every word in today’s letters.</p><div id="letters" class="letters" aria-label="Letters available"></div><form id="guess-form" class="guess-form" autocomplete="off"><label class="sr-only" for="guess">Your word</label><input id="guess" class="guess" maxlength="32" inputmode="text" autocapitalize="none" placeholder="Write a word" disabled><button id="submit" class="submit" type="submit" disabled>Submit</button></form><p id="message" class="notice" role="status"></p></section><aside class="scorecard"><div><h2>YOUR EDITION</h2><div id="score" class="score">0</div><p>points from<br><b id="count">0</b> words</p></div><hr><p><b id="timer">90</b> seconds<br>before the presses stop</p></aside></div>
            <section class="found"><p class="found-title">FOUND TODAY</p><div id="accepted" class="chips"></div></section>
            <section id="results" class="results hidden"><h2>Edition complete.</h2><p id="summary"></p><div class="results-actions"><button id="share" class="submit" type="button">Copy result</button><button id="new-round" class="secondary" type="button">Play again</button></div><details><summary>Show missed words</summary><div id="missed" class="chips"></div></details></section>
        </section>
    </main>
    <script>
    (() => {
        const storageKey='daily-word-hunt-streak-v1';
        const state={date:'',seconds:90,score:0,found:new Set(),solutions:[],ended:false,timer:null,streak:0,bestStreak:0};
        const $=id=>document.getElementById(id);
        const message=(text,tone='')=>{ $('message').textContent=text; $('message').className='notice '+tone; };
        const stats=()=>{ $('timer').textContent=state.seconds; $('score').textContent=state.score; $('count').textContent=state.found.size; $('streak').textContent=state.streak; };
        const chip=word=>{ const el=document.createElement('span'); el.className='chip'; el.textContent=word; return el; };
        const readStreak=()=>{ try { const saved=JSON.parse(localStorage.getItem(storageKey)); return saved&&typeof saved.currentStreak==='number'&&typeof saved.bestStreak==='number'?saved:{lastCompletedDate:'',currentStreak:0,bestStreak:0}; } catch { return {lastCompletedDate:'',currentStreak:0,bestStreak:0}; } };
        const previousDay=date=>{ const value=new Date(date+'T00:00:00Z'); value.setUTCDate(value.getUTCDate()-1); return value.toISOString().slice(0,10); };
        const completeToday=()=>{ const saved=readStreak(); if(saved.lastCompletedDate===state.date)return saved; const currentStreak=saved.lastCompletedDate===previousDay(state.date)?saved.currentStreak+1:1; const updated={lastCompletedDate:state.date,currentStreak,bestStreak:Math.max(saved.bestStreak,currentStreak)}; localStorage.setItem(storageKey,JSON.stringify(updated)); return updated; };
        const end=async()=>{ if(state.ended)return; state.ended=true; clearInterval(state.timer); $('guess').disabled=true; $('submit').disabled=true; const streak=completeToday(); state.streak=streak.currentStreak; state.bestStreak=streak.bestStreak; stats(); const response=await fetch('/api/solutions'); state.solutions=response.ok?await response.json():[]; const missed=state.solutions.filter(word=>!state.found.has(word)); $('summary').textContent=state.score+' points · '+state.found.size+' words found · 🔥 '+state.streak+' day streak (best '+state.bestStreak+')'; $('missed').replaceChildren(...missed.map(chip)); $('results').classList.remove('hidden'); message('Time’s up — review the words you missed.','warn'); };
        const start=async()=>{ const response=await fetch('/api/puzzle'); const puzzle=await response.json(); state.date=puzzle.date; const date=new Date(puzzle.date+'T00:00:00Z'); const weekday=date.toLocaleDateString('en-US',{weekday:'long'}).toUpperCase(); const displayDate=date.toLocaleDateString('en-US',{month:'short',day:'numeric'}).toUpperCase(); const saved=readStreak(); state.streak=(saved.lastCompletedDate===state.date||saved.lastCompletedDate===previousDay(state.date))?saved.currentStreak:0; state.bestStreak=saved.bestStreak; $('date').textContent=weekday+' EDITION · '+displayDate; $('issue').textContent=weekday+' ISSUE'; $('letters').replaceChildren(...puzzle.word.toUpperCase().split('').map(letter=>{const tile=document.createElement('span');tile.className='letter';tile.textContent=letter;return tile;})); $('guess').disabled=false; $('submit').disabled=false; $('guess').focus(); state.timer=setInterval(()=>{state.seconds--;stats();if(state.seconds<=0)end();},1000); stats(); };
        $('guess-form').addEventListener('submit',async event=>{ event.preventDefault(); if(state.ended)return; const candidate=$('guess').value.trim().toLowerCase(); if(!candidate){message('Type a word to submit.','warn');return;} if(state.found.has(candidate)){message('You already found that one.','warn');return;} const response=await fetch('/api/check?c='+encodeURIComponent(candidate)); if(!response.ok){message('Not a valid word for this puzzle.','bad');return;} const result=await response.json(); state.found.add(result.word); state.score+=result.points; $('accepted').append(chip(result.word)); $('guess').value=''; message('+'+result.points+' points','good'); stats(); });
        $('share').addEventListener('click',async()=>{ const text='Daily Word Hunt\n'+state.score+' points · '+state.found.size+' words · 🔥 '+state.streak+' day streak\n'+'🟨'.repeat(Math.min(state.found.size,10)); await navigator.clipboard.writeText(text); $('share').textContent='Copied!'; }); $('new-round').addEventListener('click',()=>location.reload()); start().catch(()=>message('Couldn’t load today’s puzzle. Refresh and try again.','bad'));
    })();
    </script>
</body>
</html>
